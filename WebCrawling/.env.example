# .env.example - API Key Template
#
# Copy this file to WebCrawling/.env and fill in your keys.
# This is the ONE .env for the whole repo — HeuristicScanner/ scripts
# (heuristic.py, main.py, save.py) 

# REQUIRED (WebCrawling only): Groq API Key
# Get from: https://console.groq.com
GROQ_API_KEY=__

# OPTIONAL (used by both WebCrawling and HeuristicScanner): GitHub API Token
# Raises GitHub's unauthenticated rate limit (60/hr) to 5000/hr.
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=__

# OPTIONAL: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# OPTIONAL: Scanner settings
SCANNER_MAX_WORKERS=3
SCANNER_OUTPUT_FILE=ai_disclosure_results.json
